{
  "name": "anime-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "setup:mpv": "node scripts/download-mpv-libs.mjs",
    "setup:ffmpeg": "node scripts/download-ffmpeg.mjs",
    "icon:setup": "node scripts/setup-icon.mjs",
    "update:mpv": "node scripts/update-mpv-libs.mjs",
    "portable": "npm run tauri build && node scripts/portable.mjs",
    "release": "npm run tauri build && npm run release:package",
    "release:package": "node scripts/release-package.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:publish": "node scripts/publish-github-release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.4.8",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
